  }

  .header {
    text-align: center;
    border-bottom: 3px solid #111;
    padding-bottom: 16px;
    margin-bottom: 20px;
  }
  .header h1 {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 1px;
