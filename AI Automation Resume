  .contact-row {
    display: flex;
    justify-content: center;
    gap: 11px;
    flex-wrap: wrap;
    margin-top: 10px;
    font-size: 10.8px;
    color: #333;
  }
  .contact-row span::after {
    content: '·';
    margin-left: 11px;
    color: #aaa;
  }
  .contact-row span:last-child::after { content: none; }

  .section { margin-bottom: 16px; }
  .section-title {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    border-bottom: 1.5px solid #111;
    padding-bottom: 4px;
    margin-bottom: 9px;
  }

  .summary {
    font-size: 11.5px;
    line-height: 1.55;
    color: #222;
  }

  .skills-grid {
    font-size: 10.8px;
    line-height: 1.7;
    color: #222;
  }
  .skill-tag { display: inline; }
  .skill-tag:not(:last-child)::after {
    content: " · ";
    color: #999;
  }

  .item { margin-bottom: 11px; }
  .item:last-child { margin-bottom: 0; }
  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px;
  }
  .item-title { font-size: 12.3px; font-weight: 700; }
  .item-meta {
    font-size: 9.8px;
    color: #555;
    font-style: italic;
    white-space: nowrap;
  }
  .item-sub{
    font-size: 10.8px; font-weight: 600; color: #333; margin-top: 1px;
  }
  ul.bullets { margin-top: 4px; padding-left: 15px; }
  ul.bullets li {
    font-size: 10.6px;
    line-height: 1.42;
    color: #222;
    margin-bottom: 2px;
