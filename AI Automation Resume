    color: #555;
    border-left: 2.5px solid #999;
    padding: 5px 0 5px 11px;
    margin-top: 6px;
    line-height: 1.4;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .placeholder { color: #999; }

  @media print {
    body { background: #fff; padding: 0; }
